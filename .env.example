# Optional. Without ANTHROPIC_API_KEY the search box uses the keyword interpreter and the engine cannot label clips.
ANTHROPIC_API_KEY=
# Optional. Turns on /admin (upload footage, run the engine). Use a long random value on a server.
ADMIN_TOKEN=
# Optional. Only used when ANTHROPIC_API_KEY is not set: interpret the search box with OpenAI instead.
OPENAI_API_KEY=
# Optional model override for OpenAI. Defaults to ai_model in config/settings.json.
PEELSET_AI_MODEL=gpt-5-mini
# Optional. Only for object-swap variants made with the engine's own command line (engine/README.md).
FAL_KEY=
# Optional. For a machine that works for a deployed site (engine/relentless/worker.py): that site's admin token.
PEELSET_ADMIN_TOKEN=
# Real card payments. The demo shortcut works without these credentials.
STRIPE_SECRET_KEY=
# Signing secret for /api/stripe/webhook (checkout.session.completed, async_payment_succeeded, expired).
STRIPE_WEBHOOK_SECRET=
